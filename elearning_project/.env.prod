# .env.prod - PRODUCTION SETTINGS
# ===============================

$EC2_IP="98.84.168.182"
@"
# Django Settings
DJANGO_SETTINGS_MODULE=elearning_project.settings.base
DJANGO_SECRET_KEY=django-insecure-w30mb%8ymwe+^2v^a6e0gukgi!60^6_cxle%lgnx^2
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=$EC2_IP,localhost,127.0.0.1

# Database
POSTGRES_DB=BTEE_DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=chisekele
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# # Redis (optional)
# REDIS_PASSWORD=generate-strong-random-password-here

# Admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=ronaldmweema@gmail.com
DJANGO_SUPERUSER_PASSWORD=chisekele

# Security
CSRF_TRUSTED_ORIGINS=$EC2_IP, http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=$EC2_IP http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_WORKER_CLASS=sync
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50

# Logging
LOG_LEVEL=INFO

# AWS Specific (for EC2)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-if-needed
AWS_SECRET_ACCESS_KEY=your-secret-key-if-needed
"@ | Out-File -Encoding UTF8 -NoNewline .env.prod

write-Host "created .env.prod file" -ForegroundColor Green